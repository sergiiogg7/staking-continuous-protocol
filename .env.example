# Deployer private key. Never commit the real value
PRIVATE_KEY=0x...

# RPC endpoint for the target network
RPC_URL=http://127.0.0.1:8545

# Address that will own both contracts after deployment
OWNER_ADDRESS=0x...

# Minimum tokens per stake call (18 decimals), for example 1 STK
MIN_STAKING_AMOUNT=1000000000000000000

# Reward period in seconds. Must be between 1 day (86400) and 365 days (31536000)
REWARDS_DURATION=2592000
